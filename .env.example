# Copie para .env e preencha. O .env NAO e versionado (ver .gitignore).
# Nunca cole estes valores em chat, commit ou captura de tela.

# --- IMAGEM: fal.ai (recomendado) ---
# fal.ai -> Settings -> API Keys
FAL_KEY=

# --- VOZ: Google Cloud Text-to-Speech ---
# console.cloud.google.com -> ativar Cloud Text-to-Speech API
# -> conta de servico -> baixar JSON -> apontar o caminho ABSOLUTO abaixo
GOOGLE_APPLICATION_CREDENTIALS=

# --- alternativas, so se for usar ---
# REPLICATE_API_TOKEN=
# ELEVENLABS_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
